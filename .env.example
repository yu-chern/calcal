# Production: copy to .env, fill in values, then run scripts/serve.sh.
AUTH_MODE=cloudflare
APP_ORIGIN=https://finanio.app
PORT=3000
CF_ACCESS_TEAM=your-team-slug
CF_ACCESS_AUD=your-access-application-audience
ALLOWED_EMAIL=you@example.com

# Agent secrets stay server-side. Model and limits live in system_config/config.toml.
OPENAI_API_KEY=replace-with-your-api-key
# For an existing PostgreSQL database:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/calcal
# Or run scripts/postgres.sh start; the app reads its private postgres.env fallback.
# SYSTEM_CONFIG=system_config/config.toml
